# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_NAME=Informe360 / HSE Copilot
NEXT_PUBLIC_ADMIN_EMAIL=prestify55@gmail.com

# HSE Copilot AI — free-first
# Groq Free Plan can provide structured extraction, vision and Whisper under account rate limits.
GROQ_API_KEY=
GROQ_HSE_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional local fallback. Example: http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_HSE_MODEL=qwen3:4b

# HSE Copilot WhatsApp — backend only. Never expose these as NEXT_PUBLIC_* or mobile env vars.
# Reuse the organization's official Meta WhatsApp provider/application credentials where applicable.
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
# Optional but recommended for reminders outside WhatsApp's active conversation window.
# The approved template body must accept {{1}} = reminder title and {{2}} = date/time.
META_WHATSAPP_REMINDER_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=es_AR
# Used only by server-side scheduled HSE jobs (WhatsApp reminders, future calendar sync).
HSE_JOBS_SECRET=

# One-time identity linking CLI inputs (do not persist real values in git).
HSE_LINK_USER_EMAIL=
HSE_LINK_ORGANIZATION=
HSE_LINK_SITE=
HSE_LINK_WHATSAPP_ID=
HSE_LINK_DISPLAY_NAME=

# Legacy/reporting AI kept optional during migration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback

